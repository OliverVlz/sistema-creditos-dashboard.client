# ============================================
# Configuración para DESARROLLO local
# ============================================
# Copia este archivo como .env y ajusta los valores

# URL del backend en desarrollo local
# Docker Desktop: http://host.docker.internal:3000
# Linux/WSL2: http://172.17.0.1:3000 o http://localhost:3000
BACKEND_URL=http://host.docker.internal:3000

# URL de la API para desarrollo (se usa en el código)
VITE_API_URL=http://localhost:3000

# Nombre de la aplicación
VITE_APP_NAME=Sistema de Créditos

