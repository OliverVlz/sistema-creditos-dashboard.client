# ============================================
# Configuración para PRODUCCIÓN en VPS
# ============================================
# Copia este archivo como .env.production y ajusta los valores
# Uso: export $(cat .env.production | xargs) && docker-compose -f docker-compose.prod.yml up -d

# URL del backend en producción
# Ejemplos:
# - Si el backend está en el mismo VPS: http://localhost:3000
# - Si el backend está en otro VPS con DNS: https://api.tudominio.com
# - Si el backend está en otro contenedor Docker: http://backend:3000
BACKEND_URL=https://api.tudominio.com

# URL de la API para el build (opcional, se usa rutas relativas en producción)
# Solo necesario si quieres especificar una URL durante el build
VITE_API_URL=

# Nombre de la aplicación
VITE_APP_NAME=Sistema de Créditos

